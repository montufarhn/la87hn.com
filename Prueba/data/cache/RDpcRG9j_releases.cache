wtunes\/commit\/ca189b1646a728235fbf445f735806e8ab40c2d9)\n- Fix: templates advanced options checkboxes didn't properly work #9   [`7f8629b`](https:\/\/github.com\/Jackysi\/pawtunes\/commit\/7f8629b1ce441051e8b471bb56bc1940fef6a309)\n\n#### Tidying of Code eg Whitespace\n\n- Style: slowly adapting Laravel PSR style of code, except 80 character line limit  [`87ea771`](https:\/\/github.com\/Jackysi\/pawtunes\/commit\/87ea771e38f56ee7d0631828ece0a25cb509937e)\n- Style: improve readability of API Panel files as well  [`cb15a41`](https:\/\/github.com\/Jackysi\/pawtunes\/commit\/cb15a41e7070e050d05e4be945884dddd6297540)\n\n#### General Changes\n\n- Create FUNDING.yml  [`15b53f8`](https:\/\/github.com\/Jackysi\/pawtunes\/commit\/15b53f865c984c9f76cac198c3cbccce636d2846)\n","reactions":{"url":"https:\/\/api.github.com\/repos\/Jackysi\/PawTunes\/releases\/198142492\/reactions","total_count":2,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":1,"rocket":1,"eyes":0}},{"url":"https:\/\/api.github.com\/repos\/Jackysi\/PawTunes\/releases\/196200802","assets_url":"https:\/\/api.github.com\/repos\/Jackysi\/PawTunes\/releases\/196200802\/assets","upload_url":"https:\/\/uploads.github.com\/repos\/Jackysi\/PawTunes\/releases\/196200802\/assets{?name,label}","html_url":"https:\/\/github.com\/Jackysi\/PawTunes\/releases\/tag\/v1.0.5","id":196200802,"author":{"login":"Jackysi","id":2860965,"node_id":"MDQ6VXNlcjI4NjA5NjU=","avatar_url":"https:\/\/avatars.githubusercontent.com\/u\/2860965?v=4","gravatar_id":"","url":"https:\/\/api.github.com\/users\/Jackysi","html_url":"https:\/\/github.com\/Jackysi","followers_url":"https:\/\/api.github.com\/users\/Jackysi\/followers","following_url":"https:\/\/api.github.com\/users\/Jackysi\/following{\/other_user}","gists_url":"https:\/\/api.github.com\/users\/Jackysi\/gists{\/gist_id}","starred_url":"https:\/\/api.github.com\/users\/Jackysi\/starred{\/owner}{\/repo}","subscriptions_url":"https:\/\/api.github.com\/users\/Jackysi\/subscriptions","o